# Epilogue configuration — copy to .env and source it, or export directly.

# --- Model provider (pick one) ------------------------------------------
# Default: Amazon Bedrock (needs AWS credentials with Claude model access)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EPILOGUE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # override if your account differs

# Google Gemini instead — FREE tier key from https://aistudio.google.com/apikey :
#   pip install -e ".[gemini]"
# EPILOGUE_MODEL_PROVIDER=gemini
# GOOGLE_API_KEY=

# Anthropic API instead:  pip install -e ".[anthropic]"
# EPILOGUE_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# OpenAI instead:  pip install -e ".[openai]"
# EPILOGUE_MODEL_PROVIDER=openai
# OPENAI_API_KEY=

# Local Ollama instead (no key):  pip install -e ".[ollama]"
# EPILOGUE_MODEL_PROVIDER=ollama
# EPILOGUE_MODEL_ID=qwen3:8b

# --- Runtime -------------------------------------------------------------
# EPILOGUE_DATA_DIR=data          # where the case ledger lives

# Hosted private workspaces (deploy.sh configures these; never expose OPENAI_API_KEY to the browser)
# EPILOGUE_AUTH_MODE=firebase
# EPILOGUE_FIRESTORE_DATABASE=epilogue
# EPILOGUE_FIREBASE_CONFIG={"apiKey":"public Firebase web key","projectId":"your-project","authDomain":"your-project.firebaseapp.com","appId":"your-app-id"}
EPILOGUE_ACCOUNT_BUDGET_USD=3
EPILOGUE_GLOBAL_BUDGET_USD=30
